{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"${ASTROLABE_TRIAL_BIN:-$HOME/.local/bin/astrolabe-trial}\" hook session-start --if-active" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "\"${ASTROLABE_TRIAL_BIN:-$HOME/.local/bin/astrolabe-trial}\" hook pre-command --if-active" } ] }
    ]
  }
}
