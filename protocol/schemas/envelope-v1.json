{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "The discriminator selects exactly one typed payload.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "body": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "review_finding"
        },
        "links": {
          "anyOf": [
            {
              "$ref": "#/$defs/Links"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/ReviewFinding"
        },
        "producer": {
          "type": "string"
        },
        "reply_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/EnvelopeVersion"
        },
        "timestamp": {
          "description": "Software-supplied RFC 3339 timestamp in UTC.",
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "schema_version",
        "id",
        "producer",
        "timestamp",
        "body",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "body": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "ask_owner_request"
        },
        "links": {
          "anyOf": [
            {
              "$ref": "#/$defs/Links"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/AskOwnerRequest"
        },
        "producer": {
          "type": "string"
        },
        "reply_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/EnvelopeVersion"
        },
        "timestamp": {
          "description": "Software-supplied RFC 3339 timestamp in UTC.",
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "schema_version",
        "id",
        "producer",
        "timestamp",
        "body",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "body": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "ask_owner_answer"
        },
        "links": {
          "anyOf": [
            {
              "$ref": "#/$defs/Links"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/AskOwnerAnswer"
        },
        "producer": {
          "type": "string"
        },
        "reply_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/EnvelopeVersion"
        },
        "timestamp": {
          "description": "Software-supplied RFC 3339 timestamp in UTC.",
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "schema_version",
        "id",
        "producer",
        "timestamp",
        "body",
        "payload"
      ]
    }
  ],
  "$defs": {
    "AskOwnerAnswer": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string"
        },
        "payload_version": {
          "$ref": "#/$defs/PayloadVersion"
        },
        "request_id": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "payload_version",
        "request_id",
        "answer"
      ]
    },
    "AskOwnerRequest": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string"
        },
        "options": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "payload_version": {
          "$ref": "#/$defs/PayloadVersion"
        },
        "question": {
          "description": "Exactly one self-contained question, never a list of questions.",
          "type": "string"
        },
        "recommendation": {
          "$ref": "#/$defs/Recommendation"
        },
        "what_waits": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "payload_version",
        "question",
        "context",
        "recommendation",
        "what_waits"
      ]
    },
    "Confidence": {
      "description": "Uncalibrated self-report; never use as a probability or approval threshold.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": true,
      "required": [
        "value",
        "method",
        "model"
      ]
    },
    "EnvelopeVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "Evidence": {
      "type": "string",
      "enum": [
        "executed",
        "inferred"
      ]
    },
    "Links": {
      "type": "object",
      "properties": {
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "PayloadVersion": {
      "description": "Payload versions evolve independently of the envelope version.",
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "Recommendation": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "action",
        "reason"
      ]
    },
    "ReviewFinding": {
      "type": "object",
      "properties": {
        "actual": {
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "expected": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "line": {
          "description": "One-based source line.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "payload_version": {
          "$ref": "#/$defs/PayloadVersion"
        },
        "revision": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "trigger": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "payload_version",
        "revision",
        "file",
        "line",
        "trigger",
        "expected",
        "actual",
        "impact",
        "evidence",
        "severity"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
