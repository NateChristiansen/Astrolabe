{
  "autoMemoryEnabled": false,
  "enableAllProjectMcpServers": true,
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "astrolabe hook config-change",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "astrolabe hook pre-command",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "astrolabe hook session-start",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__astrolabe__layer_check"
    ],
    "ask": [],
    "deny": [
      "Bash(pkill:*)",
      "PowerShell(pkill *)",
      "Bash(killall:*)",
      "PowerShell(killall *)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force *)",
      "Bash(git push -f:*)",
      "PowerShell(git push -f *)",
      "Bash(git push --force-with-lease:*)",
      "PowerShell(git push --force-with-lease *)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard *)",
      "Bash(gh pr create:*)",
      "PowerShell(gh pr create *)",
      "Bash(gh pr merge:*)",
      "PowerShell(gh pr merge *)",
      "Bash(gh pr comment:*)",
      "PowerShell(gh pr comment *)",
      "Bash(gh pr review:*)",
      "PowerShell(gh pr review *)",
      "Bash(gh pr close:*)",
      "PowerShell(gh pr close *)",
      "Bash(gh pr edit:*)",
      "PowerShell(gh pr edit *)",
      "Bash(gh issue create:*)",
      "PowerShell(gh issue create *)",
      "Bash(gh issue comment:*)",
      "PowerShell(gh issue comment *)",
      "Bash(gh issue close:*)",
      "PowerShell(gh issue close *)",
      "Bash(gh issue edit:*)",
      "PowerShell(gh issue edit *)",
      "Bash(gh issue delete:*)",
      "PowerShell(gh issue delete *)",
      "Bash(gh release create:*)",
      "PowerShell(gh release create *)",
      "Bash(gh release delete:*)",
      "PowerShell(gh release delete *)",
      "Bash(gh repo delete:*)",
      "PowerShell(gh repo delete *)",
      "Bash(gh gist create:*)",
      "PowerShell(gh gist create *)",
      "Bash(gh secret set:*)",
      "PowerShell(gh secret set *)",
      "Bash(find * -delete*)",
      "PowerShell(find * -delete*)"
    ]
  }
}
